# Copy variable names into backend/.env and set local values there. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_notetaker
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_notetaker_test
AUDIO_STORAGE_DIR=%LOCALAPPDATA%\ai-notetaker\uploads
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=kr/claude-sonnet-4.5
PROVIDER_TIMEOUT_SECONDS=60
