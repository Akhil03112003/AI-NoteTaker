```gitignore
# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ==========================================
# PYTHON
# ==========================================
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
**/env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
develop-eggs/
dist/
wheels/
pip-wheel-metadata/
wheelhouse/

# Python testing and coverage
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ==========================================
# NODE.JS / FRONTEND
# ==========================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Build output
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
*.tsbuildinfo

# Frontend test output
coverage/
**/coverage/
test-results/
**/test-results/
playwright-report/
**/playwright-report/

# ==========================================
# PLAYWRIGHT / BROWSER AUTOMATION
# ==========================================
.agents/
.playwright/
.playwright-cli/
playwright/.cache/

# ==========================================
# DATABASE FILES
# ==========================================
*.db
*.sqlite
*.sqlite3

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ==========================================
# IDE / EDITORS
# ==========================================
.idea/
.vscode/
*.iml

# ==========================================
# OPERATING SYSTEM
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ==========================================
# PROJECT-SPECIFIC LOCAL FILES
# ==========================================
.taste-skill/
uploads/
backend/uploads/
backend/audio/
*.wav
*.mp3
*.m4a
*.webm

# ==========================================
# KEEP EXAMPLE CONFIGURATION FILES
# ==========================================
!.env.example
!**/.env.example
```